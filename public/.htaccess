RewriteEngine On

# Si la requête correspond à un vrai fichier ou dossier (ex: /assets/css/style.css), on le sert tel quel
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Sinon, on redirige tout vers index.php qui se chargera du routage
RewriteRule ^ index.php [QSA,L]
